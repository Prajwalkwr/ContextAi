# Copy to .env (repository root) and fill in. The API refuses to start without the two secrets.

# Required — at least 32 random characters each
JWT_SECRET=
ENCRYPTION_KEY=

PORT=4000
# Default time zone for projects that have not set their own assistant timeZone (IANA identifier)
DEFAULT_TIME_ZONE=UTC
# Comma-separated dashboard origins allowed by CORS (empty = any origin)
CORS_ORIGINS=http://localhost:5173
# Where platform metadata is stored (defaults to apps/api/data)
DATA_DIR=

# --- Assistant (OpenAI) -------------------------------------------------------------------
# Optional main conversational model for natural-language routing, tool use, and project answers.
# Gemini can answer general questions and search the web with GEMINI_API_KEY below.
# Without either provider, project data/code questions still work deterministically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional per-task overrides (default to OPENAI_MODEL); use a cheaper model for routing.
OPENAI_ROUTER_MODEL=
OPENAI_SEARCH_MODEL=
# Hosted web search tool type for the Responses API ("web_search"; older accounts: "web_search_preview")
OPENAI_WEB_SEARCH_TOOL=web_search
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
EMBEDDINGS_ENABLED=true
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
OPENAI_ANSWER_MAX_TOKENS=2000
OPENAI_SEARCH_MAX_TOKENS=1400

# --- Any OpenAI-compatible model (local Ollama, Groq, OpenRouter…) -------------------------
# Set LLM_BASE_URL instead of (or as well as) OPENAI_API_KEY and put the model name in OPENAI_MODEL.
# Local example: install Ollama, run `ollama create contextai-llama -f apps/api/ollama/Modelfile`, then
#   LLM_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=contextai-llama
# Hosted web search and embeddings stay OpenAI-only unless OPENAI_EMBEDDING_MODEL is set.
LLM_BASE_URL=
LLM_API_KEY=

# --- Conversational agent ------------------------------------------------------------------
# With a model configured, an agent reads the whole conversation and calls validated tools.
ASSISTANT_AGENT=true
# Questions the validated data tools, live health checks or owner-verified identity answer exactly
# skip the model (faster, and immune to small-model mistakes). Set false to send everything to the agent.
ASSISTANT_VERIFIED_FAST_PATH=true
AGENT_MAX_ROUNDS=4
AGENT_HISTORY_TURNS=20
AGENT_MAX_TOKENS=900
# Share of a project-content answer's key words that must appear in what it retrieved (else it is revised)
ASSISTANT_MIN_SUPPORT=0.45
# A top-rated record with fewer reviews than this gets a low-sample caveat
RATING_RELIABLE_MIN_REVIEWS=3
# Timeout per HTTP data source request (one retry on timeout; free-tier hosts wake slowly)
HTTP_SOURCE_TIMEOUT_MS=25000

# --- Google Search grounding (Gemini API) --------------------------------------------------
# Real-time web research for current information (news, releases, "this week" questions),
# through the official @google/genai SDK with the google_search tool. Server-side only: the key
# is never sent to the dashboard, widget or SDK. Create a key at https://aistudio.google.com/apikey
# Project questions (records, ratings, live status, features, code) never go to Google Search.
GEMINI_API_KEY=
# auto (Google when GEMINI_API_KEY is set, else OpenAI hosted search) | google | openai | none
WEB_SEARCH_PROVIDER=auto
# Research model for current-information questions, and a cheaper model for general questions
# where Gemini only searches when verification helps. Model access and grounding quota vary by account.
GEMINI_SEARCH_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Used when the first model is unavailable to the key or out of quota (empty = no fallback)
GEMINI_SEARCH_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=1
GEMINI_MAX_OUTPUT_TOKENS=1500
# Grounded requests per UTC day across all projects (protects quota and spend)
GEMINI_SEARCH_DAILY_LIMIT=500
# Optional for Gemini 3 models: minimal | low | medium | high
GEMINI_THINKING_LEVEL=

# Relevance gate (calibrate with: node apps/api/scripts/eval-retrieval.js)
RETRIEVAL_MIN_COVERAGE=0.6
RETRIEVAL_MIN_SIMILARITY=0.45
# Answer cache for project/general questions (never live data, personal data or web results)
ASSISTANT_CACHE_TTL_MS=600000
CONVERSATION_TTL_MS=7200000
# Per-caller limit for /ask (LLM-backed) per RATE_LIMIT_WINDOW_MS
ASK_RATE_LIMIT_MAX=30

# Optional — private repositories, higher GitHub rate limits, push webhooks
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_MAX_FILES=1000
GITHUB_MAX_FILE_BYTES=600000
GITHUB_REQUEST_TIMEOUT_MS=15000

# Allow HTTP sources, tools and crawls to reach private/localhost addresses (self-hosted setups)
ALLOW_PRIVATE_NETWORK=false
CRAWL_MAX_PAGES=200
CRAWL_MAX_SITEMAPS=10
CRAWL_TIMEOUT_MS=15000
CRAWL_RENDER_JS=true
# Optional absolute path for a system-installed Chromium executable
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
